#: src/capture/main.cpp:1165
msgid ""
"Snapnab.exe [opções]\n"
"\n"
"/hide                 inicia só na bandeja\n"
"/capture              captura imagem com o preset de imagem atual\n"
"/video                grava vídeo com o preset de vídeo atual\n"
"/preset \"nome\"        executa um preset pelo nome\n"
"/clipboard            captura a imagem da área de transferência\n"
"/region x,y,l,a       captura essa área da tela\n"
"/window \"título\"      captura a janela cujo título contém o texto\n"
"/monitor n            captura o monitor n (1, 2…, da esquerda para a direita)\n"
"/fullscreen           captura a tela inteira\n"
"/delay s              espera s segundos antes de capturar\n"
"/ocr  /qr  /upload    reconhece o texto, lê o código QR ou envia a captura\n"
"/pin [arquivo]        fixa o arquivo na tela (sem arquivo: captura e fixa)\n"
"/pinclipboard         fixa o conteúdo da área de transferência\n"
"/colorpicker          abre o conta-gotas de tela\n"
"/focus                liga ou desliga o foco de tela\n"
"/interval [stop]      inicia (ou para) a captura por intervalo\n"
"/output clipboard|editor|none|\"arquivo\"   para onde vai a captura\n"
"/exit                 encerra o Snapnab em execução"
msgstr ""
"Snapnab.exe [options]\n"
"\n"
"/hide                 démarre seulement dans la zone de notification\n"
"/capture              capture une image avec le préréglage d'image actuel\n"
"/video                enregistre une vidéo avec le préréglage vidéo actuel\n"
"/preset \"nom\"       exécute un préréglage par son nom\n"
"/clipboard            capture l'image du presse-papiers\n"
"/region x,y,l,h       capture cette zone de l'écran\n"
"/window \"titre\"     capture la fenêtre dont le titre contient le texte\n"
"/monitor n            capture l'écran n (1, 2…, de gauche à droite)\n"
"/fullscreen           capture tout l'écran\n"
"/delay s              attend s secondes avant la capture\n"
"/ocr  /qr  /upload    reconnaît le texte, lit le code QR ou envoie la capture\n"
"/pin [fichier]        épingle le fichier à l'écran (sans fichier : capture et épingle)\n"
"/pinclipboard         épingle le contenu du presse-papiers\n"
"/colorpicker          ouvre la pipette d'écran\n"
"/focus                active ou désactive le focus d'écran\n"
"/interval [stop]      lance (ou arrête) la capture par intervalle\n"
"/output clipboard|editor|none|\"fichier\"   où va la capture\n"
"/exit                 ferme le Snapnab en cours d'exécution"

