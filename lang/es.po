#: rust/anycapture/src/cmdline.rs:111
msgid ""
"AnyCapture.exe [opções]\n"
"\n"
"/hide                 inicia só na bandeja\n"
"/capture              captura imagem com o preset de imagem atual\n"
"/video                grava vídeo com o preset de vídeo atual\n"
"/preset \"nome\"        executa um preset pelo nome\n"
"/clipboard            captura a imagem da área de transferência\n"
"/region x,y,l,a       captura essa área da tela\n"
"/window \"título\"      captura a janela cujo título contém o texto\n"
"/monitor n            captura o monitor n (1, 2…, da esquerda para a direita)\n"
"/fullscreen           captura a tela inteira\n"
"/delay s              espera s segundos antes de capturar\n"
"/ocr  /qr  /upload    reconhece o texto, lê o código QR ou envia a captura\n"
"/pin [arquivo]        fixa o arquivo na tela (sem arquivo: captura e fixa)\n"
"/pinclipboard         fixa o conteúdo da área de transferência\n"
"/colorpicker          abre o conta-gotas de tela\n"
"/focus                liga ou desliga o foco de tela\n"
"/interval [stop]      inicia (ou para) a captura por intervalo\n"
"/output clipboard|editor|none|\"arquivo\"   para onde vai a captura\n"
"/exit                 encerra o AnyCapture em execução"
msgstr ""
"AnyCapture.exe [opciones]\n"
"\n"
"/hide                 se inicia solo en la bandeja\n"
"/capture              captura una imagen con el ajuste de imagen actual\n"
"/video                graba vídeo con el ajuste de vídeo actual\n"
"/preset \"nombre\" ejecuta un ajuste por su nombre   \n"
"/clipboard            captura la imagen del portapapeles\n"
"/region x,y,an,al     captura esa área de la pantalla\n"
"/window \"título\"    captura la ventana cuyo título contiene el texto\n"
"/monitor n            captura el monitor n (1, 2…, de izquierda a derecha)\n"
"/fullscreen           captura la pantalla completa\n"
"/delay s              espera s segundos antes de capturar\n"
"/ocr  /qr  /upload    reconoce el texto, lee el código QR o sube la captura\n"
"/pin [archivo]        fija el archivo en la pantalla (sin archivo: captura y fija)\n"
"/pinclipboard         fija el contenido del portapapeles\n"
"/colorpicker          abre el cuentagotas de pantalla\n"
"/focus                activa o desactiva el foco de pantalla\n"
"/interval [stop]      inicia (o detiene) la captura por intervalo\n"
"/output clipboard|editor|none|\"archivo\"   adónde va la captura\n"
"/exit                 cierra el AnyCapture en ejecución"

