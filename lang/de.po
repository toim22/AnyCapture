#: rust/anycapture/src/cmdline.rs:114
msgid ""
"AnyCapture.exe [opções]\n"
"\n"
"/hide                 inicia só na bandeja\n"
"/capture              captura imagem com o preset de imagem atual\n"
"/video                grava vídeo com o preset de vídeo atual\n"
"/preset \"nome\"        executa um preset pelo nome\n"
"/clipboard            captura a imagem da área de transferência\n"
"/region x,y,l,a       captura essa área da tela\n"
"/window \"título\"      captura a janela cujo título contém o texto\n"
"/monitor n            captura o monitor n (1, 2…, da esquerda para a direita)\n"
"/fullscreen           captura a tela inteira\n"
"/delay s              espera s segundos antes de capturar\n"
"/ocr  /qr  /upload    reconhece o texto, lê o código QR ou envia a captura\n"
"/pin [arquivo]        fixa o arquivo na tela (sem arquivo: captura e fixa)\n"
"/pinclipboard         fixa o conteúdo da área de transferência\n"
"/colorpicker          abre o conta-gotas de tela\n"
"/focus                liga ou desliga o foco de tela\n"
"/interval [stop]      inicia (ou para) a captura por intervalo\n"
"/output clipboard|editor|none|\"arquivo\"   para onde vai a captura\n"
"/exit                 encerra o AnyCapture em execução"
msgstr ""
"AnyCapture.exe [Optionen]\n"
"\n"
"/hide                 startet nur im Infobereich\n"
"/capture              nimmt ein Bild mit der aktuellen Bildvorlage auf\n"
"/video                zeichnet Video mit der aktuellen Videovorlage auf\n"
"/preset \"Name\"      führt eine Vorlage über ihren Namen aus\n"
"/clipboard            nimmt das Bild aus der Zwischenablage auf\n"
"/region x,y,b,h       nimmt diesen Bildschirmbereich auf\n"
"/window \"Titel\"     nimmt das Fenster auf, dessen Titel den Text enthält\n"
"/monitor n            nimmt Monitor n auf (1, 2…, von links nach rechts)\n"
"/fullscreen           nimmt den ganzen Bildschirm auf\n"
"/delay s              wartet s Sekunden vor der Aufnahme\n"
"/ocr  /qr  /upload    erkennt Text, liest den QR-Code oder lädt die Aufnahme hoch\n"
"/pin [Datei]          heftet die Datei an (ohne Datei: aufnehmen und anheften)\n"
"/pinclipboard         heftet den Inhalt der Zwischenablage an\n"
"/colorpicker          öffnet die Bildschirm-Farbpipette\n"
"/focus                schaltet den Bildschirmfokus ein oder aus\n"
"/interval [stop]      startet (oder beendet) die Intervallaufnahme\n"
"/output clipboard|editor|none|\"Datei\"   wohin die Aufnahme geht\n"
"/exit                 beendet das laufende AnyCapture"

