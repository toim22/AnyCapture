#: src/capture/main.cpp:1165
msgid ""
"Snapnab.exe [opções]\n"
"\n"
"/hide                 inicia só na bandeja\n"
"/capture              captura imagem com o preset de imagem atual\n"
"/video                grava vídeo com o preset de vídeo atual\n"
"/preset \"nome\"        executa um preset pelo nome\n"
"/clipboard            captura a imagem da área de transferência\n"
"/region x,y,l,a       captura essa área da tela\n"
"/window \"título\"      captura a janela cujo título contém o texto\n"
"/monitor n            captura o monitor n (1, 2…, da esquerda para a direita)\n"
"/fullscreen           captura a tela inteira\n"
"/delay s              espera s segundos antes de capturar\n"
"/ocr  /qr  /upload    reconhece o texto, lê o código QR ou envia a captura\n"
"/pin [arquivo]        fixa o arquivo na tela (sem arquivo: captura e fixa)\n"
"/pinclipboard         fixa o conteúdo da área de transferência\n"
"/colorpicker          abre o conta-gotas de tela\n"
"/focus                liga ou desliga o foco de tela\n"
"/interval [stop]      inicia (ou para) a captura por intervalo\n"
"/output clipboard|editor|none|\"arquivo\"   para onde vai a captura\n"
"/exit                 encerra o Snapnab em execução"
msgstr ""
"Snapnab.exe [параметры]\n"
"\n"
"/hide                 запуск только в области уведомлений\n"
"/capture              снимок изображения текущим шаблоном изображения\n"
"/video                запись видео текущим шаблоном видео\n"
"/preset \"имя\"       запуск шаблона по имени\n"
"/clipboard            снимок изображения из буфера обмена\n"
"/region x,y,ш,в       снимает эту область экрана\n"
"/window \"заголовок\" снимает окно, заголовок которого содержит текст\n"
"/monitor n            снимает монитор n (1, 2…, слева направо)\n"
"/fullscreen           снимает весь экран\n"
"/delay s              ждёт s секунд перед снимком\n"
"/ocr  /qr  /upload    распознаёт текст, читает QR-код или загружает снимок\n"
"/pin [файл]           закрепляет файл на экране (без файла: снимает и закрепляет)\n"
"/pinclipboard         закрепляет содержимое буфера обмена\n"
"/colorpicker          открывает экранную пипетку\n"
"/focus                включает или выключает фокус экрана\n"
"/interval [stop]      запускает (или останавливает) съёмку по интервалу\n"
"/output clipboard|editor|none|\"файл\"   куда идёт снимок\n"
"/exit                 закрыть запущенный Snapnab"

