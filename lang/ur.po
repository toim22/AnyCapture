#: src/capture/main.cpp:1156
msgid ""
"Snapnab.exe [opções]\n"
"\n"
"/hide                 inicia só na bandeja\n"
"/capture              captura imagem com o preset de imagem atual\n"
"/video                grava vídeo com o preset de vídeo atual\n"
"/preset \"nome\"        executa um preset pelo nome\n"
"/clipboard            captura a imagem da área de transferência\n"
"/region x,y,l,a       captura essa área da tela\n"
"/window \"título\"      captura a janela cujo título contém o texto\n"
"/monitor n            captura o monitor n (1, 2…, da esquerda para a direita)\n"
"/fullscreen           captura a tela inteira\n"
"/delay s              espera s segundos antes de capturar\n"
"/ocr  /qr  /upload    reconhece o texto, lê o código QR ou envia a captura\n"
"/pin [arquivo]        fixa o arquivo na tela (sem arquivo: captura e fixa)\n"
"/pinclipboard         fixa o conteúdo da área de transferência\n"
"/colorpicker          abre o conta-gotas de tela\n"
"/focus                liga ou desliga o foco de tela\n"
"/interval [stop]      inicia (ou para) a captura por intervalo\n"
"/output clipboard|editor|none|\"arquivo\"   para onde vai a captura\n"
"/exit                 encerra o Snapnab em execução"
msgstr ""
"Snapnab.exe [اختیارات]\n"
"\n"
"/hide                 صرف اطلاعاتی حصے میں شروع کریں\n"
"/capture              موجودہ تصویری پری سیٹ سے تصویر کیپچر کریں\n"
"/video                موجودہ ویڈیو پری سیٹ سے ویڈیو ریکارڈ کریں\n"
"/preset \"نام\"       نام سے پری سیٹ چلائیں\n"
"/clipboard            کلپ بورڈ کی تصویر کیپچر کریں\n"
"/region x,y,چ,ا       اسکرین کا یہ حصہ کیپچر کرتا ہے\n"
"/window \"عنوان\"     وہ ونڈو کیپچر کرتا ہے جس کے عنوان میں متن ہو\n"
"/monitor n            مانیٹر n کیپچر کرتا ہے (1، 2…، بائیں سے دائیں)\n"
"/fullscreen           پوری اسکرین کیپچر کرتا ہے\n"
"/delay s              کیپچر سے پہلے s سیکنڈ انتظار کرتا ہے\n"
"/ocr  /qr  /upload    متن پہچانتا ہے، QR کوڈ پڑھتا ہے یا کیپچر اپ لوڈ کرتا ہے\n"
"/pin [فائل]           فائل اسکرین پر پن کرتا ہے (فائل کے بغیر: کیپچر کر کے پن کرتا ہے)\n"
"/pinclipboard         کلپ بورڈ کا مواد پن کرتا ہے\n"
"/colorpicker          اسکرین رنگ چننے والا کھولتا ہے\n"
"/focus                اسکرین فوکس آن یا آف کرتا ہے\n"
"/interval [stop]      وقفے سے کیپچر شروع (یا بند) کرتا ہے\n"
"/output clipboard|editor|none|\"فائل\"   کیپچر کہاں جاتا ہے\n"
"/exit                 چلتا ہوا Snapnab بند کریں"

